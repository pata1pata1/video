{
  "version": 1,
  "name": "default",
  "status": "draft",
  "note": "仮の default（Phase 3 の焼き込みで使う）。実動画で調整し、良かった形を pattern-01.json として固定する。サイズ・位置は画面の短辺（shortSide）に対する比率なので、16:9 と 9:16 で同じ設定が使える。",
  "font": {
    "family": "Noto Sans JP",
    "weight": 800,
    "sizeRatio": 0.055,
    "lineHeight": 1.3,
    "letterSpacingEm": 0.02
  },
  "color": "#FFFFFF",
  "stroke": { "enabled": true, "color": "#000000", "widthRatio": 0.12, "opacity": 0.9 },
  "background": { "enabled": false, "color": "#000000", "opacity": 0.55, "paddingEm": [0.2, 0.5], "radiusEm": 0.25 },
  "shadow": { "enabled": true, "color": "#000000", "blurEm": 0.15, "opacity": 0.6 },
  "position": { "anchor": "bottom", "marginRatio": 0.08, "maxWidthRatio": 0.9, "align": "center" },
  "layout": {
    "maxLines": 2,
    "maxCharsPerLine": { "landscape": 22, "portrait": 14, "square": 18 },
    "breakPreference": ["。", "、", "particle", "anywhere"],
    "minDisplaySeconds": 0.8,
    "maxDisplaySeconds": 6,
    "gapMergeSeconds": 0.15
  },
  "emphasis": { "enabled": false, "color": "#FFE14D", "terms": "glossary" }
}
