{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "../../../remotion/node_modules/@types/*",
        "../../../remotion/node_modules/*"
      ]
    },
    "typeRoots": [
      "../../../remotion/node_modules/@types"
    ],
    "types": []
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
