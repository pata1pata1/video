{
  "app": { "entryPoint": "src/index.ts", "lessonComposition": "Lesson" },
  "dictionary": "lessons/shared/pronunciation.json",
  "voice": {
    "settings": { "speedScale": 1.04, "pitchScale": 0, "intonationScale": 1.0, "volumeScale": 1.0 }
