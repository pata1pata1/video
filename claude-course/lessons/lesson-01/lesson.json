          "lines": [
            { "id": "l011", "text": "Claude Codeは、パソコンの中のファイルを読むことができます。" },
            { "id": "l012", "text": "新しいファイルを作ったり、今あるファイルを修正したりもできます。" },
            { "id": "l013", "text": "さらに、コードを書き、作業そのものを進めてくれます。" }
          ]
        },
