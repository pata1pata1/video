          "visual": {},
          "lines": [
            {
              "id": "l029",
              "text": "伝える内容は、このような日本語です。"
            },
            {
              "id": "l030",
              "text": "店名を今の約1.5倍にして下さい。"
            },
            {
              "id": "l031",
              "text": "ボタンの背景を濃いブラウンにして、文字を白にして下さい。"
            }
          ]
        },
        {
          "id": "s11-fix-mobile",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l032",
              "text": "あわせて、スマートフォンでも文字やメニューが重ならないようにお願いしました。"
            },
            {
              "id": "l033",
              "text": "このように、できあがったものを見ながら、変更したい部分を具体的に伝えていきます。"
            }
          ]
        }
      ]
    },
