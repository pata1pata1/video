      "scenes": [
        {
          "id": "s01-intro",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l001",
              "text": "今回は、Claude Codeに日本語でお願いして、美容サロンのホームページを作ってみます。"
            },
            {
              "id": "l002",
              "text": "作成したページを確認し、文字の大きさやボタンの色を変更するところまで、"
            },
            {
              "id": "l003",
              "text": "実際の操作をお見せします。"
            },
            {
              "id": "l004",
              "text": "まずは、どんなページができるのか、ご覧下さい。"
            }
          ]
        },
        {
          "id": "s02-finished",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l005",
              "text": "こちらが、今回作成する架空の美容サロン、ルミエールのホームページです。"
            },
            {
              "id": "l006",
              "text": "お店の紹介やメニュー、料金、アクセスなどを載せています。"
            },
            {
              "id": "l007",
              "text": "今回は、このページのコードを自分で入力する代わりに、"
            },
            {
              "id": "l008",
              "text": "作りたい内容を日本語で伝えて制作しました。"
            },
            {
              "id": "l009",
              "text": "どのように進めたのか、最初から見ていきましょう。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch02",
      "number": "02",
      "title": "日本語で依頼する",
      "scenes": [
        {
          "id": "s03-request-screen",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l010",
              "text": "こちらが、Claude Codeに依頼している画面です。"
            },
            {
              "id": "l011",
              "text": "見慣れない画面かもしれませんが、注目して頂きたいのは、日本語で書いた指示の部分です。"
            }
          ]
        },
        {
          "id": "s04-request-content",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l012",
              "text": "今回は、美容サロンのホームページを作ってほしいと伝えています。"
            },
            {
              "id": "l013",
              "text": "色は白とベージュ。"
            },
            {
              "id": "l014",
              "text": "雰囲気は上品で落ち着いたデザイン。"
            },
            {
              "id": "l015",
              "text": "さらに、お店の紹介やメニューなど、載せたい内容も指定しました。"
            }
          ]
        },
        {
          "id": "s05-request-point",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l016",
              "text": "ポイントは、何を作りたいか、どんな見た目にしたいか、何を載せたいかを伝える事です。"
            },
            {
              "id": "l017",
              "text": "最初から専門用語を並べる必要はありません。"
            },
            {
              "id": "l018",
              "text": "まずは、自分の希望を言葉にしてみましょう。"
            }
          ]
        },
        {
          "id": "s06-request-send",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l019",
              "text": "指示を送ると、Claude Codeが制作を進めます。"
            },
            {
              "id": "l020",
              "text": "ここは、待ち時間を短縮してお見せします。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch03",
      "number": "03",
      "title": "できたページを確認する",
      "scenes": [
        {
          "id": "s07-first-check",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l021",
              "text": "ページができたので、ブラウザで開いて確認します。"
            },
            {
              "id": "l022",
              "text": "白とベージュを基調にしたデザインになっていますね。"
            },
            {
              "id": "l023",
              "text": "下に進むと、お店の紹介、メニューと料金、サロンの特徴、アクセスが並んでいます。"
            }
          ]
        },
        {
          "id": "s08-check-yourself",
          "layout": "recording",
          "visual": {},
          "lines": [
            {
              "id": "l024",
              "text": "ただし、できあがったら終わりではありません。"
            },
            {
              "id": "l025",
              "text": "文章や料金に間違いがないか、見やすいか、ボタンが動くかを、自分でも確認します。"
            },
            {
              "id": "l026",
              "text": "今回は架空のお店を題材にしたデモなので、料金や所在地もサンプルです。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch04",
