      "number": 1,
      "heading": "寝床でスマホ",
      "lines": [
        {
          "id": "c1a",
          "kind": "fact",
          "factIds": [
            "phone"
          ],
          "text": "1つ目は、寝る前や布団の中で、スマホを見ることです。",
