    "crowd": {
      "query": "shibuya crossing people"
    }
  },
  "scenes": [
    {
      "id": "opening",
      "kind": "opening",
      "lines": [
        {
          "id": "o1",
          "visual": {
            "title": true,
            "footage": "gyudon"
          },
          "text": "2026年10月13日、松屋の牛めしが値上がりしました。"
        },
        {
          "id": "o2",
          "visual": {
            "stat": {
              "value": "480",
              "unit": "円",
              "label": "牛めし並盛（460円から）"
            },
            "footage": "counter"
          },
          "text": "並盛は460円から480円に。牛めしは全サイズ、一律20円のアップです。"
        },
        {
          "id": "o3",
          "visual": {
            "footage": "riceshop"
          },
          "text": "ところが、スーパーのお米は、8週連続で値下がりしています。"
        },
        {
          "id": "o4",
          "visual": {
            "footage": "rice"
          },
          "text": "お米が安くなっているのに、なぜ牛丼は高くなるのでしょうか。"
        },
        {
          "id": "o5",
          "visual": {
            "footage": "coins"
          },
          "text": "松屋の決算の数字から計算すると、意外な事実が見えてきます。"
        },
        {
          "id": "o6",
          "visual": {
            "footage": "kitchen"
          },
          "text": "この動画では、牛丼一杯480円の中身と、値上げの理由を解説します。"
        }
      ]
    },
    {
      "id": "c1",
      "kind": "chapter",
      "number": 1,
      "heading": "今回の値上げで何が変わった？",
      "footage": "counter",
      "lines": [
        {
          "id": "c1a",
          "text": "まずは、今回の値上げの中身を、松屋フーズの発表で確認しましょう。"
        },
        {
          "id": "c1b",
          "visual": {
            "points": {
              "title": "主な値上げ（税込み）",
              "items": [
                "牛めし並盛　460円 → 480円",
                "得朝牛皿定食　400円 → 430円",
                "玉子かけごはん　350円 → 380円",
                "おこさま牛めし　450円 → 480円"
              ]
            }
          },
          "text": "牛めし類は全品20円ですが、朝定食やお子さまメニューには、30円上がるものもあります。"
        },
        {
          "id": "c1c",
          "visual": {
            "footage": "truck"
          },
          "text": "松屋が挙げた理由は、原材料費、人件費、物流費、光熱費、包装資材費の上昇です。"
        },
        {
          "id": "c1d",
          "visual": {
            "diagram": "rivals",
            "step": 1
          },
          "text": "では、ほかの大手の牛丼と比べると、どうでしょうか。"
        },
        {
          "id": "c1e",
          "visual": {
            "diagram": "rivals",
            "step": 2
          },
          "text": "すき家は2026年7月に30円値上げして、並盛480円になりました。"
        },
        {
          "id": "c1e2",
          "text": "すき家は2025年9月に450円へ値下げしていたので、480円に戻した形です。"
        },
        {
          "id": "c1f",
          "visual": {
            "diagram": "rivals",
            "step": 3
          },
          "text": "吉野家の店内価格は498円なので、大手3社が500円の手前に並んだことになります。"
        }
      ]
    },
    {
      "id": "c2",
      "kind": "chapter",
      "number": 2,
      "heading": "牛めしの値段の移り変わり",
      "footage": "tokyo",
      "lines": [
        {
          "id": "c2a",
          "text": "次に、牛めしの値段がこれまでどう変わってきたのかを見てみます。"
        },
        {
          "id": "c2b",
          "visual": {
            "diagram": "history",
            "step": 1
          },
          "text": "松屋の発表によると、2012年1月、牛めし並盛は320円から280円に値下げされました。"
        },
        {
          "id": "c2c",
          "visual": {
            "diagram": "history",
            "step": 2
          },
          "text": "そこから値段は少しずつ上がり、2024年7月には400円から430円に。"
        },
        {
          "id": "c2c2",
          "text": "このときから関東の店では、夜10時から朝5時までの注文に、深夜料金もかかるようになりました。"
        },
        {
          "id": "c2d",
          "visual": {
            "diagram": "history",
            "step": 3
          },
          "text": "2025年4月に460円、そして今回の480円です。"
        },
        {
          "id": "c2e",
          "visual": {
            "stat": {
              "value": "1.7",
              "unit": "倍",
              "label": "2012年の280円と比べて"
            },
            "footage": "gyudon"
          },
          "text": "2012年の280円と比べると200円高く、およそ1.7倍になりました。"
        },
        {
          "id": "c2f",
          "visual": {
            "footage": "tokyo"
          },
          "text": "前回の値上げは2025年4月なので、およそ1年半ぶりの値上げです。"
        }
      ]
    },
    {
      "id": "c3",
      "kind": "chapter",
      "number": 3,
      "heading": "480円の中身を分解",
      "footage": "register",
      "lines": [
        {
          "id": "c3a",
          "text": "では、480円は、いったい何に使われているのでしょうか。"
        },
        {
          "id": "c3b",
          "visual": {
            "footage": "chart"
          },
          "text": "手がかりは、松屋フーズホールディングスが2026年5月に発表した決算です。"
        },
        {
          "id": "c3c",
          "visual": {
            "stat": {
              "value": "1844",
              "unit": "億円",
              "label": "売上高（2026年3月までの1年間）"
            },
            "footage": "chart"
          },
          "text": "2026年3月までの1年間の売上高は、1844億円。前の年より2割近く増えました。"
        },
        {
          "id": "c3d",
          "visual": {
            "diagram": "breakdown",
            "step": 1
          },
          "text": "この売上を100とすると、食材などの原価は36.8です。"
        },
        {
          "id": "c3d2",
          "text": "前の年は36.1だったので、原価の割合はさらに上がっています。"
        },
        {
          "id": "c3e",
          "visual": {
            "diagram": "breakdown",
            "step": 2
          },
          "text": "お店で働く人の人件費が29.6、そのほかの経費が29.5でした。"
        },
        {
          "id": "c3f",
          "visual": {
            "diagram": "breakdown",
            "step": 3
          },
          "text": "残った営業利益は、わずか4.1しかありません。"
        },
        {
          "id": "c3g",
          "visual": {
            "diagram": "breakdown",
            "step": 4
          },
          "text": "この割合を480円の牛めしに当てはめると、利益はおよそ20円になります。"
        },
        {
          "id": "c3h",
          "text": "会社全体の数字を当てはめた目安ですが、今回の値上げ幅と同じくらいなんです。"
        },
        {
          "id": "c3i",
          "visual": {
            "footage": "coins"
          },
          "text": "つまり牛丼は、コストが少し上がるだけで、利益がすぐに消えてしまう商売なんです。"
        }
      ]
    },
    {
      "id": "c4",
      "kind": "chapter",
      "number": 4,
      "heading": "牛肉が高い理由",
      "footage": "cattle",
      "lines": [
        {
          "id": "c4a",
          "text": "ここからは、値上げの理由を一つずつ見ていきます。まずは主役の牛肉です。"
        },
        {
          "id": "c4b",
          "visual": {
            "footage": "beef"
          },
          "text": "牛丼によく使われるのは、アメリカ産の牛のバラ肉、ショートプレートです。"
        },
        {
          "id": "c4c",
          "visual": {
            "stat": {
              "value": "8620",
              "unit": "万頭",
              "label": "アメリカの牛の数（2026年1月）"
            },
            "footage": "cattle"
          },
          "text": "ところが、アメリカの牛の数は、2026年1月の時点で8620万頭。"
        },
        {
          "id": "c4d",
          "visual": {
            "footage": "cattle"
          },
          "text": "アメリカ農務省の調査で、1951年以来、およそ75年ぶりの少なさです。"
        },
        {
          "id": "c4e",
          "visual": {
            "footage": "drought"
          },
          "text": "長く続いた干ばつで、牛を育てる農家が、牛の数を減らしてきたことが原因とされています。"
        },
        {
          "id": "c4e2",
          "visual": {
            "footage": "cattle"
          },
          "text": "さらに、牛に寄生する害虫の問題で、メキシコからの牛の輸入も止まっていると報じられています。"
        },
        {
          "id": "c4f",
          "visual": {
            "diagram": "imports",
            "step": 1
          },
          "text": "その影響は、日本への輸入にも出ています。"
        },
        {
          "id": "c4g",
          "visual": {
            "diagram": "imports",
            "step": 2
          },
          "text": "2026年7月、アメリカ産の冷凍牛肉の輸入量は、前の年の79.4%まで減りました。"
        },
        {
          "id": "c4h",
          "visual": {
            "footage": "ranch"
          },
          "text": "農畜産業振興機構の見通しでも、ショートプレートを中心に、高値が続くとされています。"
        },
        {
          "id": "c4i",
          "visual": {
            "stat": {
              "value": "1652",
              "unit": "円/kg",
              "label": "米国産ショートプレートの卸値（2026年9月後半・首都圏）"
            },
            "footage": "beef"
          },
          "text": "首都圏の卸の取引では、2026年9月後半に、1キロあたり1652円の値がついています。"
        },
        {
          "id": "c4j",
          "visual": {
            "footage": "port"
          },
          "text": "すき家も7月の値上げでは、牛肉の高騰を理由の一つに挙げていました。"
        }
      ]
    },
    {
      "id": "c5",
      "kind": "chapter",
      "number": 5,
      "heading": "お米は安いのに、なぜ？",
      "footage": "riceshop",
      "lines": [
        {
          "id": "c5a",
          "text": "ここで気になるのが、お米の値段です。"
        },
        {
          "id": "c5b",
          "visual": {
            "stat": {
              "value": "2860",
              "unit": "円",
              "label": "スーパーのお米5kgの平均（9/28〜10/4）"
            },
            "footage": "riceshop"
          },
          "text": "農林水産省の発表では、スーパーのお米5キロの平均は2860円。8週連続の値下がりです。"
        },
        {
          "id": "c5c",
          "visual": {
            "footage": "rice"
          },
          "text": "2025年3月には4206円と、前の年の2倍を超えていたので、だいぶ落ち着いてきました。"
        },
        {
          "id": "c5d",
          "visual": {
            "footage": "kitchen"
          },
          "text": "実際、松屋フーズの決算でも、お米の値上がりが原価を押し上げたと説明されています。"
        },
        {
          "id": "c5e",
          "visual": {
            "footage": "worker"
          },
          "text": "それでも値上げするのは、お米以外のコストが上がり続けているからです。"
        },
        {
          "id": "c5f",
          "visual": {
            "diagram": "labor",
            "step": 1
          },
          "text": "まず人件費です。2026年度の最低賃金は、全国平均で1177円。"
        },
        {
          "id": "c5g",
          "visual": {
            "diagram": "labor",
            "step": 2
          },
          "text": "前の年から56円上がり、10月から順番に、各地で引き上げられています。"
        },
        {
          "id": "c5h",
          "visual": {
            "diagram": "labor",
            "step": 3
          },
          "text": "松屋フーズの人件費は、1年でおよそ70億円増えて、545億円になりました。"
        },
        {
          "id": "c5i",
          "visual": {
            "points": {
              "title": "上がり続けるコスト",
              "items": [
                "人件費",
                "物流費",
                "光熱費",
                "包装資材費"
              ]
            }
          },
          "text": "さらに、物流費や光熱費、包装資材費も上がっています。"
        },
        {
          "id": "c5j",
          "visual": {
            "footage": "truck"
          },
          "text": "お米が少し安くなっても、ほかのコストの上昇分までは埋まらない、ということです。"
        }
      ]
    },
    {
      "id": "c6",
      "kind": "chapter",
      "number": 6,
      "heading": "値上げで客は減ったのか",
      "footage": "crowd",
      "lines": [
        {
          "id": "c6a",
          "text": "最後に、値上げでお客さんが離れていないのか、見てみましょう。"
        },
        {
          "id": "c6b",
          "visual": {
            "diagram": "sales",
            "step": 1
          },
          "text": "2026年3月までの1年間、松屋フーズの既存店の売上は、前の年より10.5%増えました。"
        },
        {
          "id": "c6c",
          "visual": {
            "diagram": "sales",
            "step": 2
          },
          "text": "お客さんの数は1.2%増え、一人あたりの支払いは9.2%増えています。"
        },
        {
          "id": "c6d",
          "visual": {
            "footage": "counter"
          },
          "text": "値上げを続けても、お客さんの数は前の年並みを保っている、ということです。"
        },
        {
          "id": "c6e",
          "visual": {
            "footage": "crowd"
          },
          "text": "会社は、次の1年も、既存店のお客さんを2.5%増やす計画を立てています。"
        },
        {
          "id": "c6f",
          "visual": {
            "footage": "cattle"
          },
          "text": "一方で、アメリカの牛の数が元に戻るには、何年もかかるという見方もあります。"
        },
        {
          "id": "c6g",
          "visual": {
            "footage": "gyudon"
          },
          "text": "牛丼500円時代が来るのかどうか、これからの値段にも注目です。"
        }
      ]
    },
    {
      "id": "ending",
      "kind": "ending",
      "lines": [
        {
          "id": "e1",
          "text": "最後までご覧いただき、ありがとうございました。"
        },
        {
          "id": "e2",
          "text": "牛丼の値上げについてどう思うか、ぜひコメントで教えてください。"
        },
        {
          "id": "e3",
          "text": "高評価とチャンネル登録も、よろしくお願いします。"
        }
      ]
    }
  ],
