    },
    "counter": {
      "query": "japanese restaurant counter"
    },
    "kitchen": {
      "query": "restaurant kitchen cooking"
    },
    "register": {
      "query": "cash register payment"
    },
    "chart": {
      "query": "financial report documents"
    },
    "cattle": {
      "query": "cattle ranch herd"
    },
    "beef": {
      "query": "raw beef slices"
    },
    "drought": {
      "query": "dry cracked land drought"
    },
    "port": {
      "query": "container ship port"
    },
    "worker": {
      "query": "restaurant staff working"
