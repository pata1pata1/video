{
  "id": "gyudon-price",
  "pattern": "pattern-01",
  "title": "お米は安いのに、なぜ？ 松屋の牛めし480円の中身を分解",
  "titleTop": "松屋の牛めし 20円値上げ",
  "titleMain": "牛丼480円の中身",
  "titleSub": "お米は安いのに、なぜ値上げ？",
  "pronunciation": {
    "お米": "オコメ",
    "並盛": "ナミモリ"
  },
  "media": {
    "gyudon": {
      "query": "beef rice bowl"
    },
    "coins": {
      "query": "japanese yen coins"
    },
    "rice": {
