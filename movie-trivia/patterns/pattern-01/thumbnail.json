    "outline": "#000000"
  },
  "layout": {
    "image": {
      "videoFrame": 90,
      "note": "映像を全面に敷く（動画素材なら連番の90コマ目。台本の frame で変更、imagePosition で位置調整）"
    },
    "shade": {
      "gradient": "linear-gradient(90deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.7) 42%, rgba(0,0,0,0) 72%)",
      "note": "文字の側（左）だけ暗くする"
    },
    "left": 52,
    "ribbon": {
      "size": 50,
      "top": 44,
      "rotate": -2,
      "note": "赤い帯に白文字"
    },
    "lines": {
      "size": 112,
      "outline": 16,
      "note": "白文字に黒の太縁取り。1〜2行"
    },
    "accentWord": {
      "size": 168,
      "sizeIfLong": 130,
      "longOver": 6,
      "outline": 20,
      "note": "黄色で特大"
    },
    "badge": {
      "size": 300,
      "right": 40,
      "bottom": 40,
      "rotate": 6,
      "topSize": 40,
      "bigSize": 96,
      "bigSizeIfLong": 76,
      "bigLongOver": 4,
      "bottomSize": 34,
      "note": "右下の赤い丸。数字を一目で（任意）"
    },
    "small": {
      "size": 36,
      "bottom": 44,
      "barWidth": 8,
      "note": "左下に黒地の補足（任意）"
    }
  },
  "rules": [
    "文言は少なく大きく（1〜2行＋黄色の強調語1つ＋バッジの数字）",
    "根拠のない数字・あおりは使わない（common/production-rules.md）。バッジの数字も本編・出典と同じ根拠のあるものだけ",
    "映像の内容と文言で誤解を生まない組み合わせにする",
    "目安・推計の数字には「約」や「（目安）」を付ける"
  ]
}
