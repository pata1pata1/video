      "attribution": []
    },
    {
      "kind": "fact",
      "factIds": [
        "crowds-cost"
      ],
      "cards": [
        {
          "text": "沿道には見物人が集まり、",
          "image": "06.jpg",
          "caption": "沿道には\n見物人が集まり"
        },
        {
          "text": "藩は、えさや水、宿の世話に、",
          "caption": "藩は えさや水\n宿の世話に"
